{
  "nodeModulesDir": "auto",
  "tasks": {
    "hub": "deno run -A hub/main.ts",
    "worker": "deno run --allow-net --allow-env --allow-read=.worker-token --allow-write=.worker-token --allow-sys=hostname,osRelease,systemMemoryInfo,loadavg,osUptime --allow-run worker/main.ts",
    "admin": "deno run --allow-read=data --allow-write=data admin.ts",
    "install": "deno install"
  },
  "imports": {
    "discord.js": "npm:discord.js@14"
  }
}
