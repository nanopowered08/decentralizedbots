# Hub (Replit secrets)
DISCORD_TOKEN=
GUILD_ID=
OWNER_IDS=            # your Discord user id(s), enables /run and /fetch
APPROVED_NODES=       # approved worker ids, comma separated
REPO_URL=https://github.com/nanopowered08/nodebot.git

# Worker
HUB_URL=wss://your-repl.replit.app/connect
NODE_NAME=my-phone
ALLOW_RUN=            # programs /run may execute on this worker, e.g. echo,df,uptime
